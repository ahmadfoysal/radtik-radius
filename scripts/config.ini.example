# RADTik RADIUS server - scripts/config.ini
# install.sh creates config.ini from this file and fills in the API token and the database path.
# config.ini holds secrets: never commit it, never share it.

[api]
# Address and port of the API (gunicorn serves HTTPS on port 5000, see radtik-radius-api.service)
host = 0.0.0.0
port = 5000

# Bearer token the panel must send. Must equal the "API token" of this server in the RADTik panel
# (panel: RADIUS server -> Verify Token Sync / Push Credentials). 32-128 characters of A-Z a-z 0-9 _ -
auth_token = your-secure-token-here

# Never enable in production
debug = false

[laravel]
# Base URL of the RADTik panel, without a trailing slash. activation-sync.py reports logins to
# <api_url>/api/radius/activations
api_url = https://radtik.example.com

[radius]
# FreeRADIUS SQLite database
db_path = /etc/freeradius/3.0/sqlite/radius.db
